{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "carousel-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/carousel/CarouselWebPart.js",
          "manifest": "./src/webparts/carousel/CarouselWebPart.manifest.json"
        }
      ]
    },
    "people-search-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/peopleSearch/PeopleSearchWebPart.js",
          "manifest": "./src/webparts/peopleSearch/PeopleSearchWebPart.manifest.json"
        }
      ]
    },
    "knowledge-explorer-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/knowledgeExplorer/KnowledgeExplorerWebPart.js",
          "manifest": "./src/webparts/knowledgeExplorer/KnowledgeExplorerWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "CarouselWebPartStrings": "lib/webparts/carousel/loc/{locale}.js",
    "PeopleSearchWebPartStrings": "lib/webparts/peopleSearch/loc/{locale}.js",
    "KnowledgeExplorerWebPartStrings": "lib/webparts/knowledgeExplorer/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}
